{
  "name": "agent-jake-browser-mcp-extension",
  "version": "2.4.0",
  "description": "Browser automation extension for AI agents via Model Context Protocol",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @agent-browser/extension-core",
    "dev:preview": "npm run dev:preview --workspace @agent-browser/extension-core",
    "build": "npm run build --workspace @agent-browser/extension-core",
    "preview": "npm run preview --workspace @agent-browser/extension-core",
    "test:unit": "npm run test:unit --workspace @agent-browser/extension-core && npm run test:composition",
    "test:unit:watch": "npm run test:unit:watch --workspace @agent-browser/extension-core",
    "typecheck": "npm run typecheck --workspaces",
    "generate:icons": "npm run generate:icons --workspace @agent-browser/extension-core",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:composition": "vitest run --config vitest.config.ts",
    "verify:protocol": "node vendor/protocol/verify.mjs vendor/protocol/agent-jake-browser-protocol.tgz vendor/protocol/provenance.json"
  },
  "keywords": [
    "chrome-extension",
    "browser-automation",
    "mcp",
    "ai"
  ],
  "author": "Agent Jake",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0",
    "ws": "^8.21.3",
    "@types/ws": "^8.18.1"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
