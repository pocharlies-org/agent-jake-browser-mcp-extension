{
  "name": "@agent-browser/extension-core",
  "version": "2.4.0",
  "description": "Browser automation extension for AI agents via Model Context Protocol",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "npm run build && vite build --watch & vite --config vite.preview.config.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:icons": "node scripts/generate-icons.js"
  },
  "keywords": [
    "chrome-extension",
    "browser-automation",
    "mcp",
    "ai"
  ],
  "author": "Agent Jake",
  "license": "MIT",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@playwright/test": "^1.57.0",
    "@types/chrome": "^0.1.33",
    "@types/node": "^25.0.9",
    "playwright": "^1.57.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^2.1.0",
    "vue-tsc": "^3.2.3"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "pinia": "^3.0.4",
    "sharp": "^0.34.5",
    "vue": "^3.5.27",
    "zod": "^4.3.5",
    "@agent-jake-browser/protocol": "file:../../vendor/protocol/agent-jake-browser-protocol.tgz"
  },
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  }
}
